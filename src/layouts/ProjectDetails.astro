---
import { render, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import Giscus from "@/components/Giscus.astro";
import { categoryLabel } from "@/constants";
import { SITE } from "@/config";

export interface Props {
  proyecto: CollectionEntry<"proyectos">;
}

const { proyecto } = Astro.props;
const {
  title,
  description,
  catalogo,
  categoria,
  cover,
  stack,
  metricas,
  ficha,
  repo,
  demo,
  pubDatetime,
  modDatetime,
} = proyecto.data;

const { Content, headings } = await render(proyecto);
const anio = new Date(pubDatetime).getFullYear();

// El rail son los `##` del Markdown; la tabla de resultados se agrega al final
const pasos = [
  ...headings
    .filter(h => h.depth === 2)
    .map(h => ({ slug: h.slug, text: h.text })),
  ...(metricas.length > 0 ? [{ slug: "resultados", text: "Resultados" }] : []),
];
---

<Layout
  title={`${title} | ${SITE.title}`}
  description={description}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
  scrollSmooth={true}
>
  <Header />
  <main
    id="main-content"
    class="mx-auto w-full max-w-app px-4 pb-12"
    data-pagefind-body
  >
    <p class="mt-6 text-sm text-foreground/60">
      <a href="/proyectos/" class="hover:text-accent">Proyectos</a> &rsaquo; {
        categoryLabel(categoria)
      } &rsaquo; {catalogo}
    </p>

    <div class="hero" style={`--label: var(--c-${categoria}); --on: var(--on-${categoria})`}>
      <div class="hero-art">
        <div class="hero-disc"></div>
        {
          cover ? (
            <Image
              src={cover}
              alt={`Portada de ${title}`}
              width={440}
              height={440}
              class="hero-cover"
            />
          ) : null
        }
        <div class="hero-face">
          <span class="hero-no">{catalogo}</span>
          <span class="hero-tt">{title}</span>
        </div>
      </div>

      <div>
        <h1 class="hero-title">{title}</h1>
        <p class="hero-lead">{description}</p>

        <dl class="facts">
          <div class="fact"><dt>Año</dt><dd>{anio}</dd></div>
          {ficha.duracion && <div class="fact"><dt>Duración</dt><dd>{ficha.duracion}</dd></div>}
          {ficha.datos && <div class="fact"><dt>Datos</dt><dd>{ficha.datos}</dd></div>}
          {ficha.rol && <div class="fact"><dt>Rol</dt><dd>{ficha.rol}</dd></div>}
          {
            metricas[0] && (
              <div class="fact">
                <dt>{metricas[0].nombre}</dt>
                <dd>{metricas[0].valor}</dd>
              </div>
            )
          }
        </dl>

        <div class="actions">
          {demo && <a class="action primary" href={demo} target="_blank" rel="noopener noreferrer">Probar el modelo</a>}
          {repo && <a class="action" href={repo} target="_blank" rel="noopener noreferrer">Código en GitHub</a>}
          <a class="action" href="/proyectos/">← Volver a Proyectos</a>
        </div>
      </div>
    </div>

    <div class="cols">
      <nav class="rail" aria-label="Etapas del proyecto">
        <p class="rail-title">El pipeline</p>
        <ol>
          {
            pasos.map((p, i) => (
              <li>
                <a href={`#${p.slug}`} class={i === 0 ? "on" : ""}>
                  <span class="rail-num">{String(i).padStart(2, "0")}</span>
                  {p.text}
                </a>
              </li>
            ))
          }
        </ol>

        {
          stack.length > 0 && (
            <div class="rail-stack">
              <p class="rail-title">Stack</p>
              <div class="credits">
                {stack.map(s => (
                  <span class="credit-tag">{s}</span>
                ))}
              </div>
            </div>
          )
        }
      </nav>

      <article
        id="article"
        class="app-prose max-w-none prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
      >
        <Content />

        {
          metricas.length > 0 && (
            <>
              <h2 id="resultados">Resultados</h2>
              <table>
                <thead>
                  <tr>
                    <th>Métrica</th>
                    <th>Valor</th>
                  </tr>
                </thead>
                <tbody>
                  {metricas.map(m => (
                    <tr>
                      <td>{m.nombre}</td>
                      <td>{m.valor}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </>
          )
        }
      </article>
    </div>

    <hr class="my-8 border-dashed" />

    <section class="comentarios" data-pagefind-ignore>
      <h2 class="comentarios-title">Comentarios</h2>
      <p class="comentarios-desc">
        ¿Dudas sobre el pipeline o ideas para mejorarlo? Los comentarios usan
        GitHub Discussions: necesitas una cuenta de GitHub para escribir.
      </p>
      <Giscus />
    </section>

    <BackToTopButton />
  </main>
  <Footer />
</Layout>

<style>
  /* ===== hero ===== */
  .hero {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 1.75rem;
    align-items: start;
    margin: 1rem 0 1.75rem;
    padding: 1.75rem;
    background: var(--panel);
    border: 1px solid var(--color-border);
    border-radius: 14px;
  }
  .hero-art {
    position: relative;
    width: 200px;
    height: 200px;
    padding: 0.8rem;
    border-radius: 6px;
    color: var(--on);
    background: linear-gradient(160deg, var(--label), var(--label) 55%, rgb(0 0 0 / 0.42));
  }
  .hero-art :global(.hero-cover) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 6px;
    z-index: 1;
  }
  .hero-disc {
    position: absolute;
    top: 22px;
    inset-inline-start: 68px;
    width: 156px;
    height: 156px;
    border-radius: 50%;
    z-index: 0;
    pointer-events: none;
    background: repeating-radial-gradient(circle, var(--vinyl) 0 3px, #241d1b 3px 6px);
    box-shadow: var(--shadow-disc);
    animation: hero-spin 12s linear infinite;
  }
  .hero-disc::after {
    content: "";
    position: absolute;
    inset: 40%;
    border-radius: 50%;
    background: var(--label);
  }
  @keyframes hero-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .hero-face {
    position: relative;
    z-index: 2;
  }
  .hero-no {
    display: block;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    opacity: 0.9;
    text-shadow: 0 1px 6px rgb(0 0 0 / 0.5);
  }
  .hero-tt {
    display: block;
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.12;
    text-shadow: 0 1px 6px rgb(0 0 0 / 0.5);
  }
  .hero-title {
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.15;
    margin: 0 0 0.5rem;
    color: var(--color-accent);
    text-wrap: balance;
  }
  .hero-lead {
    color: var(--ink-soft);
    margin: 0 0 1rem;
    max-width: 60ch;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 0.75rem 1.25rem;
    margin: 0 0 1.1rem;
  }
  .fact {
    border-top: 1px solid var(--color-border);
    padding-top: 0.35rem;
  }
  .fact dt {
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
    margin: 0;
  }
  .fact dd {
    margin: 0.1rem 0 0;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .action {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.82rem;
    border: 1.5px solid var(--color-border);
    color: var(--ink-soft);
    border-radius: 999px;
    padding: 0.38rem 0.9rem;
    transition:
      border-color 0.2s,
      color 0.2s,
      transform 0.2s;
  }
  .action:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    transform: translateY(-1px);
  }
  .action.primary {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--background);
  }
  .action.primary:hover {
    opacity: 0.9;
    color: var(--background);
  }

  /* ===== rail + contenido ===== */
  .cols {
    display: grid;
    grid-template-columns: 190px 1fr;
    gap: 2.25rem;
    align-items: start;
  }
  .rail {
    position: sticky;
    top: 1.25rem;
  }
  .rail-title {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-muted);
    margin: 0 0 0.6rem;
  }
  .rail ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rail li {
    position: relative;
    padding: 0 0 0 1.6rem;
  }
  .rail li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0.32rem;
    top: 1.35rem;
    bottom: -0.1rem;
    width: 1px;
    background: var(--color-border);
  }
  .rail li:last-child::before {
    display: none;
  }
  .rail a {
    display: block;
    text-decoration: none;
    color: var(--ink-soft);
    font-size: 0.84rem;
    padding: 0.3rem 0;
    transition: color 0.2s;
  }
  .rail a::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    top: 0.72rem;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    border: 1.5px solid var(--color-border);
    background: var(--background);
    transition:
      background 0.25s,
      border-color 0.25s,
      transform 0.25s;
  }
  .rail a:hover {
    color: var(--foreground);
  }
  .rail a.on {
    color: var(--color-accent);
    font-weight: 700;
  }
  .rail a.on::before {
    background: var(--color-accent);
    border-color: var(--color-accent);
    transform: scale(1.15);
  }
  .rail-num {
    display: block;
    font-size: 0.64rem;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .rail-stack {
    margin-top: 1.75rem;
  }
  .credits {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .credit-tag {
    font-size: 0.72rem;
    background: var(--panel-2);
    border: 1px solid var(--color-border);
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    color: var(--ink-soft);
  }

  /* ===== comentarios ===== */
  .comentarios-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0 0 0.35rem;
  }
  .comentarios-desc {
    color: var(--ink-soft);
    font-size: 0.88rem;
    margin: 0 0 1.25rem;
    max-width: 60ch;
  }

  @media (max-width: 820px) {
    .cols {
      grid-template-columns: 1fr;
    }
    .rail {
      position: static;
      margin-bottom: 1.5rem;
    }
    .rail ol {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }
    .rail li {
      padding: 0;
    }
    .rail li::before,
    .rail a::before {
      display: none;
    }
    .rail a {
      border: 1px solid var(--color-border);
      border-radius: 999px;
      padding: 0.3rem 0.7rem;
    }
    .rail-num {
      display: none;
    }
    .hero {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-disc {
      animation: none;
    }
  }
</style>

<script>
  function initRail() {
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>(".rail a")
    );
    if (!links.length) return;

    const sections = links.map(a =>
      document.querySelector(decodeURIComponent(a.hash))
    );

    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          const i = sections.indexOf(entry.target);
          links.forEach((a, j) => a.classList.toggle("on", j === i));
        });
      },
      { rootMargin: "-15% 0px -70% 0px" }
    );

    sections.forEach(s => s && observer.observe(s));
  }

  document.addEventListener("astro:page-load", initRail);
</script>
